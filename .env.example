# ============================================
# Nucleus AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# cp .env.example .env

# --- LLM Provider ---
# Choose: "gemini" (free API) or "ollama" (local, free)
LLM_PROVIDER=gemini

# Google Gemini API Key (get free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (free tier; gemini-2.0-flash was retired in June 2026)
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when GEMINI_MODEL is too slow (15 s), overloaded or out of free quota
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Ollama (Local LLM) ---
# Only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Embedding Model ---
# Runs locally with ONNX Runtime, no API key needed. Any sentence-transformers
# repo on Hugging Face that ships onnx/model_quint8_avx2.onnx works.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Prebuilt index ---
# Downloaded at server start when there is no local index. Defaults to the
# `index-latest` release of github.com/Likheet/Nucleus-AI; set empty to disable.
# INDEX_URL=https://github.com/Likheet/Nucleus-AI/releases/download/index-latest/nucleus-index.tar.gz

# --- Scraper ---
# Seconds between requests (robots.txt's Crawl-delay wins if it is longer)
CRAWL_DELAY=1.5
# Sitemap path prefixes to index (comma-separated)
SITEMAP_PATHS=/student
ALLOWED_DOMAINS=www.unsw.edu.au,student.unsw.edu.au,www.handbook.unsw.edu.au

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
